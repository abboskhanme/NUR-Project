# ===========================================================================
# NUR Agent — namuna konfiguratsiya. Nusxa oling:  cp .env.example .env
# Bu fayl (.env) repo'ga TUSHMAYDI (yuqoridagi .dockerignore + repo .gitignore).
#
# MUHIM: quyidagilarning KO'PCHILIGINI (AI kalit, Instagram token, Telegram,
# model va h.k.) endi ERP UI'dan boshqarsa bo'ladi: Sozlamalar > Tizim sozlamalari
# (super-admin). Agent ularni ERP'dan startup'da va har 5 daqiqada avtomatik
# oladi va RESTARTSIZ qo'llaydi. Shu sabab .env da FAQAT ikkitasi majburiy:
#   ERP_INGEST_URL  va  AGENT_INGEST_KEY  (agent ERP bilan bog'lanishi uchun).
# Qolganini .env'ga yozsangiz — ERP'da bo'sh bo'lса, .env qiymati ishlaydi (fallback).
# ===========================================================================
# DIQQAT: qiymat BO'SH bo'lgan qatorga yonma-yon izoh yozmang —
#   KEY=            # izoh
# bunda «# izoh» matnining o'zi QIYMAT bo'lib o'qiladi (dotenv shunday ishlaydi)
# va agent noto'g'ri sozlama bilan ishga tushadi. Izohni yuqoridagi qatorga yozing.


# --- AI provayder ---------------------------------------------------------
# claude  -> sifatli, jonli sotuvda tavsiya (default)
# gemini  -> arzon/tez, dastlabki test uchun
AI_PROVIDER=claude

# Claude (Anthropic)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# Arzonroq variantlar: claude-sonnet-5, claude-haiku-4-5

# Gemini (Google)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Opus 5'da fikrlash yoqiq va u ham shu limitdan yeydi — 2048 dan pastga tushirmang.
AI_MAX_TOKENS=2048
AI_EFFORT=low                # low | medium | high

# --- Instagram (Instagram Login API — Facebook Page KERAK EMAS) ------------
# Bu yo'lda o'z akkauntimiz uchun App Review talab qilinmaydi.
# Qiymatlarni Meta App > Instagram > "API setup with Instagram login" dan olasiz.
# Instagram App ID
IG_APP_ID=
# Instagram App Secret (webhook imzosi uchun ham)
IG_APP_SECRET=
# webhook'ni tasdiqlash uchun o'zingiz o'ylab topasiz
IG_VERIFY_TOKEN=
# masalan https://domeningiz.uz/agent  (HTTPS shart)
AGENT_PUBLIC_URL=

# Quyidagi uchtasini QO'LDA to'ldirish shart emas — /connect sahifasi
# (Instagram login oynasi) ularni o'zi oladi va ERP'ga saqlaydi.
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_TOKEN_ISSUED_AT=
IG_API_BASE=https://graph.instagram.com
GRAPH_API_VERSION=v23.0

# --- ERP ulanishi (yagona, tor chegara) -----------------------------------
# Dev (bitta compose): http://backend:8000/api/v1/leads/ingest
# Lokal (compose'siz):  http://localhost:8011/api/v1/leads/ingest
ERP_INGEST_URL=http://backend:8000/api/v1/leads/ingest
# ERP .env.prod dagi AGENT_INGEST_KEY bilan BIR XIL bo'lsin (majburiy)
AGENT_INGEST_KEY=

# --- Telegram bildirishnoma (agentning ALOHIDA boti, ERP botidan boshqa) --
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DAILY_REPORT_TIME=20:00      # kunlik jamlanma vaqti (HH:MM, TIMEZONE bo'yicha)

# --- Holat / boshqa --------------------------------------------------------
# Redis bo'lsa DM konteksti + dedup shu yerda; bo'sh bo'lsa ichki xotira fallback.
REDIS_URL=
KNOWLEDGE_DIR=data/knowledge
TIMEZONE=Asia/Tashkent
DEDUP_TTL=86400              # bir xil komment/xabarni takror ishlamaslik (soniya)
BOT_PAUSE_HOURS=12           # operator qo'lda javob bersa, bot shuncha soat jim turadi
LOG_LEVEL=INFO

COMPANY_NAME=NUR
