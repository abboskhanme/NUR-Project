# Ikkinchi brend nusxasi — docker-compose.brand2.yml uchun.
# Serverda: cp .env.brand2.example .env.brand2 && nano .env.brand2
# (.env.brand2 git'ga TUSHMAYDI.)  Domen esa NUR'ning .env.prod ida: BRAND2_DOMAIN=...

# --- Brend (UI, PDF hujjatlar, Telegram bot salomlashuvi) ---
BRAND_APP_NAME=
BRAND_COMPANY=
BRAND_SHORT_NAME=
# Kvadrat belgidagi harf (bo'sh bo'lsa BRAND_APP_NAME ning birinchi harfi)
BRAND_INITIAL=
# Chek logotipi: frontend/public ichidagi fayl, mas. /brand2-logo.jpg ; yo'q bo'lsa none
BRAND_LOGO=none
BRAND_EMAIL=
BRAND_PHONE=
BRAND_SITE=

# Kafolat sertifikatidagi telefonlar (vergul bilan)
DOC_SALES_PHONES=
DOC_SERVICE_PHONES=
DOC_SALES_SIGNER=
DOC_SERVICE_SIGNER=

# --- Xavfsizlik (MAJBURIY) ---
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Ishlatilmaydi, lekin production'da standart qiymat taqiqlangan
INIT_ADMIN_PASSWORD=
