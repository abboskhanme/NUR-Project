# NUR Project — Caddy reverse proxy + avtomatik HTTPS (Let's Encrypt).
# {$DOMAIN} qiymati .env.prod fayldan keladi (masalan: erp.nurtechno.uz).
# Caddy domen uchun SSL sertifikatni o'zi oladi va yangilab turadi.

{$DOMAIN} {
    encode gzip

    # Backend API — /api/* va /health backendga
    @api path /api/* /health
    handle @api {
        reverse_proxy backend:8000
    }

    # NUR Agent (Instagram webhook) — /agent/* -> agent:8000 (prefiks olib tashlanadi).
    # Meta webhook URL: https://<DOMAIN>/agent/webhook/instagram
    # Faqat "agent" profili yoqilganda ishlaydi (aks holda 502 — hech kim urmaydi).
    handle_path /agent/* {
        reverse_proxy agent:8000
    }

    # Qolgan hamma narsa (React SPA) frontend nginx'ga
    handle {
        reverse_proxy frontend:80
    }
}

# «www»siz (apex) domen — asosiy domenga yo'naltiriladi.
# Sayt ikki xil manzilda ochilib qolmasligi uchun aynan REDIRECT qilinadi:
# aks holda foydalanuvchi www'da tizimga kirsa, apex'da kirmagan bo'lib
# ko'rinadi (brauzer saqlagan token domenga bog'liq).
#
# .env.prod da beriladi:  DOMAIN_APEX=nurtechnogroup.uz
# Berilmasa — hech qachon mos kelmaydigan manzil ishlatiladi va `http://`
# sxemasi tufayli Caddy unga sertifikat ham so'ramaydi.
{$DOMAIN_APEX:http://apex.invalid} {
    redir https://{$DOMAIN}{uri} permanent
}
